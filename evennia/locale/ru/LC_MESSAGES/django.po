#: commands/default/general.py:35
msgid "home"
msgstr "домой"

#: commands/default/general.py:41
msgid ""
"\n"
"            move to your character's home location\n"
"\n"
"            Usage:\n"
"              home\n"
"\n"
"            Teleports you to your home location.\n"
"            "
msgstr ""
"\n"
"            переместиться в домашнюю локацию вашего персонажа\n"
"\n"
"            Использование:\n"
"              домой\n"
"\n"
"            Телепортирует вас в вашу домашнюю локацию.\n"
"            "

#: commands/default/general.py:56
msgid "You have no home!"
msgstr "У вас нет домашней локации!"

#: commands/default/general.py:58
msgid "You are already home!"
msgstr "Вы уже дома!"

#: commands/default/general.py:60
msgid "There's no place like home ..."
msgstr "В гостях хорошо, а дома лучше…"

#: commands/default/general.py:65
msgid "look"
msgstr "смотреть"

#: commands/default/general.py:66
msgid "l, ls"
msgstr "см"

#: commands/default/general.py:72
msgid ""
"\n"
"            look at location or object\n"
"\n"
"            Usage:\n"
"              look\n"
"              look <obj>\n"
"              look *<account>\n"
"\n"
"            Observes your location or objects in your vicinity.\n"
"            "
msgstr ""
"\n"
"            посмотреть на место или объект\n"
"\n"
"            Использование:\n"
"              смотреть\n"
"              смотреть <объект>\n"
"              смотреть *<аккаунт>\n"
"\n"
"            Осмотреть место или объект в вашей досягаемости.\n"
"            "

#: commands/default/general.py:92
msgid "You have no location to look at!"
msgstr "Вам не на что смотреть!"

#: commands/default/general.py:359
msgid "inventory"
msgstr "инвентарь"

#: commands/default/general.py:360
msgid "inv, i"
msgstr "инв"

#: commands/default/general.py:366
msgid ""
"\n"
"            view inventory\n"
"\n"
"            Usage:\n"
"              inventory\n"
"              inv\n"
"\n"
"            Shows your inventory.\n"
"            "
msgstr ""
"\n"
"            посмотреть инвентарь\n"
"\n"
"            Использование:\n"
"              инвентарь\n"
"              инв\n"
"\n"
"            Показать ваш инвентарь.\n"
"            "

#: commands/default/general.py:381
msgid "You are not carrying anything."
msgstr "Вы ничего не несёте с собой."

#: commands/default/general.py:391
#, python-brace-format
msgid ""
"|wYou are carrying:\n"
"{}"
msgstr ""
"|wВы несёте:\n"
"{}"

#: commands/default/general.py:434
msgid "get"
msgstr "взять"

#: commands/default/general.py:435
msgid "grab"
msgstr "вз"

#: commands/default/general.py:441
msgid ""
"\n"
"            pick up something\n"
"\n"
"            Usage:\n"
"              get <obj>\n"
"\n"
"            Picks up an object from your location and puts it in your "
"inventory.\n"
"            "
msgstr ""
"\n"
"            подобрать что-то\n"
"\n"
"            Использование:\n"
"              взять <объект>\n"
"\n"
"            Подобрать объект из вашей локации и поместить его в инвентарь.\n"
"            "

#: commands/default/general.py:457
msgid "Get what?"
msgstr "Что вы хотели взять?"

#: commands/default/general.py:467
msgid "You can't get yourself."
msgstr "Вы не можете взять самого себя."

#: commands/default/general.py:477
msgid "You can't get that."
msgstr "Вы не можете взять это."

#: commands/default/general.py:493
msgid "That can't be picked up."
msgstr "Вы не можете подобрать это."

#: commands/default/general.py:498
#, python-brace-format
msgid "You pick up {obj_name}."
msgstr "Вы подбираете {obj_name}."

#: commands/default/general.py:499
#, python-brace-format
msgid "{subj_name} picks up {obj_name}."
msgstr "{subj_name} подбирает {obj_name}."

#: commands/default/general.py:500
#, python-brace-format
msgid "$You() $conj(pick) up {obj_name}."
msgstr "$You() $conj(подобрать) {obj_name}."

#: commands/default/general.py:505
msgid "drop"
msgstr "выбросить"

#: commands/default/general.py:511
msgid ""
"\n"
"            drop something\n"
"\n"
"            Usage:\n"
"              drop <obj>\n"
"\n"
"            Lets you drop an object from your inventory into the\n"
"            location you are currently in.\n"
"            "
msgstr ""
"\n"
"            выбросить что-то\n"
"\n"
"            Использование:\n"
"              выбросить <объект>\n"
"\n"
"            Выбросить объект из вашего инвентаря в текущую локацию.\n"
"            "

#: commands/default/general.py:527
msgid "Drop what?"
msgstr "Что вы хотите выбросить?"

#: commands/default/general.py:535
#, python-brace-format
msgid "You aren't carrying {args}."
msgstr "Вы не несёте {args}."

#: commands/default/general.py:536
#, python-brace-format
msgid "You carry more than one {args}:"
msgstr "Вы несёте более одного {args}:"

#: commands/default/general.py:561
msgid "That can't be dropped."
msgstr "Вы не можете выбросить это."

#: commands/default/general.py:566
#, python-brace-format
msgid "You drop {obj_name}."
msgstr "Вы выбрасываете {obj_name}."

#: commands/default/general.py:567
#, python-brace-format
msgid "{subj_name} drops {obj_name}."
msgstr "{subj_name} выбрасывает {obj_name}."

#: commands/default/general.py:568
#, python-brace-format
msgid "$You() $conj(drop) {obj_name}."
msgstr "$You() $conj(выбрасывать) {obj_name}."

#: commands/default/general.py:573
msgid "give"
msgstr "дать"

#: commands/default/general.py:574
msgid "=, to "
msgstr " "

#: commands/default/general.py:580
msgid ""
"\n"
"            give away something to someone\n"
"\n"
"            Usage:\n"
"              give <inventory obj> <to||=> <target>\n"
"\n"
"            Gives an item from your inventory to another person,\n"
"            placing it in their inventory.\n"
"            "
msgstr ""
"\n"
"            дать кому-то что-то\n"
"\n"
"            Использование:\n"
"              дать <объект в инвентаре> <цель>\n"
"\n"
"            Дать объект из вашего инвентаря кому-то, помещая этот объект в "
"его инвентарь.\n"
"            "

#: commands/default/general.py:596
msgid "Usage: give <inventory object> = <target>"
msgstr "Использование: дать <объект из инвентаря> <цель>"

#: commands/default/general.py:602
#, python-brace-format
msgid "You aren't carrying {lhs}."
msgstr "Вы не несёте {lhs}."

#: commands/default/general.py:603
#, python-brace-format
msgid "You carry more than one {lhs}:"
msgstr "Вы несёте более одного {lhs}:"

#: commands/default/general.py:620
#, python-brace-format
msgid "You keep {item} to yourself."
msgstr "Вы оставляете {item} у себя."

#: commands/default/general.py:642
#, python-brace-format
msgid "You could not give that to {name}."
msgstr "Вы не можете дать это {name}."

#: commands/default/general.py:649
#, python-brace-format
msgid "You give {obj_name} to {name}."
msgstr "Вы даёте {obj_name} {name}."

#: commands/default/general.py:654
#, python-brace-format
msgid "{name} gives you {obj_name}."
msgstr "{name} даёт вам {obj_name}."

#: commands/default/general.py:661
msgid "setdesc"
msgstr "описание"

#: commands/default/general.py:667
msgid ""
"\n"
"            describe yourself\n"
"\n"
"            Usage:\n"
"              setdesc <description>\n"
"\n"
"            Add a description to yourself. This\n"
"            will be visible to people when they\n"
"            look at you.\n"
"            "
msgstr ""
"\n"
"            описать себя\n"
"\n"
"            Использование:\n"
"              описание <description>\n"
"\n"
"            Добавить описание себя. Оно будет видно другим игрокам.\n"
"            "

#: commands/default/general.py:683
msgid "You must add a description."
msgstr "Вы должны задать описание."

#: commands/default/general.py:687
msgid "You set your description."
msgstr "Вы задаёте своё описание."

#: commands/default/general.py:691
msgid "say"
msgstr "говорить"

#: commands/default/general.py:692
msgid "\", '"
