#: accounts/accounts.py:481
msgid "You are already puppeting this object."
msgstr "Вы уже управляете этим объектом."

#: accounts/accounts.py:485
#, python-brace-format
msgid "You don't have permission to puppet '{key}'."
msgstr "'{key}’: нет прав на управление."

#: accounts/accounts.py:494
#, python-brace-format
msgid "Sharing |c{name}|n with another of your sessions."
msgstr "|c{name}|n используется совместно с другой вашей сессией."

#: accounts/accounts.py:498
#, python-brace-format
msgid "|c{name}|n|G is now shared from another of your sessions.|n"
msgstr "|c{name}|n|G теперь используется совместно из другой вашей сессии.|n"

#: accounts/accounts.py:503
#, python-brace-format
msgid "Taking over |c{name}|n from another of your sessions."
msgstr "|c{name}|n: перехват управления от другой вашей сессии."

#: accounts/accounts.py:507
#, python-brace-format
msgid "|c{name}|n|R is now acted from another of your sessions.|n"
msgstr "|c{name}|n|R теперь управляется из другой вашей сессии.|n"

#: accounts/accounts.py:514
#, python-brace-format
msgid "|c{key}|R is already puppeted by another Account."
msgstr "|c{key}|R уже управляется другим аккаунтом."

#: accounts/accounts.py:534
#, python-brace-format
msgid "You cannot control any more puppets (max {max_puppets})"
msgstr "Вы не можете управлять большим количество персонажей (максимум: {max_puppets})"

#: accounts/accounts.py:729
msgid "Too many login failures; please try again in a few minutes."
msgstr "Слишком много неудачных попыток входа. Попробуйте снова через несколько минут."

#: accounts/accounts.py:742 accounts/accounts.py:1069
msgid ""
"|rYou have been banned and cannot continue from here.\n"
"If you feel this ban is in error, please email an admin.|x"
msgstr ""
"|rВы заблокированы.\n"
"Если вы считаете блокировку ошибочной, напишите администратору.|x"

#: accounts/accounts.py:754
msgid "Username and/or password is incorrect."
msgstr "Неверное имя пользователя и/или пароль."

#: accounts/accounts.py:761
msgid "Too many authentication failures."
msgstr "Слишком много неудачных попыток аутентификации."

#: accounts/accounts.py:1040
msgid "You are creating too many accounts. Please log into an existing account."
msgstr "Вы создаёте слишком много аккаунтов. Пожалуйста, войдите в существующий аккаунт."

#: accounts/accounts.py:1086
msgid "There was an error creating the Account. If this problem persists, contact an admin."
msgstr "Ошибка при создании аккаунта. Если проблема не исчезает, свяжитесь с администратором."

#: accounts/accounts.py:1130 accounts/accounts.py:2055
msgid "An error occurred. Please e-mail an admin if the problem persists."
msgstr "Произошла ошибка. Если проблема не исчезает, напишите администратору."

#: accounts/accounts.py:1163
msgid "Account being deleted."
msgstr "Аккаунт в процессе удаления."

#: accounts/accounts.py:1734 accounts/accounts.py:2073
#, python-brace-format
msgid "|G{key} connected|n"
msgstr "|G{key}: подключение|n"

#: accounts/accounts.py:1740
msgid "The Character does not exist."
msgstr "Персонаж не существует."

#: accounts/accounts.py:1774
#, python-brace-format
msgid "|R{key} disconnected{reason}|n"
msgstr "|R{key}: отключение ({reason}) |n"

#: accounts/accounts.py:2008
msgid "Guest accounts are not enabled on this server."
msgstr "Гостевые аккаунты отключены на этом сервере."

#: accounts/accounts.py:2018
msgid "All guest accounts are in use. Please try again later."
msgstr "Все гостевые аккаунты заняты. Попробуйте позже."

#: commands/cmdhandler.py:85
msgid ""
"\n"
"An untrapped error occurred.\n"
msgstr ""
"\n"
"Произошла необработанная ошибка.\n"

#: commands/cmdhandler.py:90
msgid ""
"\n"
"An untrapped error occurred. Please file a bug report detailing the steps to reproduce.\n"
msgstr ""
"\n"
"Произошла необработанная ошибка. Пожалуйста, создайте отчёт об ошибке с шагами для воспроизведения.\n"

#: commands/cmdhandler.py:98
msgid ""
"\n"
"A cmdset merger-error occurred. This is often due to a syntax\n"
"error in one of the cmdsets to merge.\n"
msgstr ""
"\n"
"Ошибка слияния набора команд. Обычно это вызвано синтаксической\n"
"ошибкой в одном из объединяемых наборов команд.\n"

#: commands/cmdhandler.py:104
msgid ""
"\n"
"A cmdset merger-error occurred. Please file a bug report detailing the\n"
"steps to reproduce.\n"
msgstr ""
"\n"
"Ошибка слияния набора команд. Пожалуйста, создайте отчёт об ошибке\n"
"с шагами для воспроизведения.\n"

#: commands/cmdhandler.py:113
msgid ""
"\n"
"No command sets found! This is a critical bug that can have\n"
"multiple causes.\n"
msgstr ""
"\n"
"Наборы команд не найдены! Это критическая ошибка, которая может иметь\n"
"несколько причин.\n"

#: commands/cmdhandler.py:119
msgid ""
"\n"
"No command sets found! This is a sign of a critical bug.  If\n"
"disconnecting/reconnecting doesn't\" solve the problem, try to contact\n"
"the server admin through\" some other means for assistance.\n"
msgstr ""
"\n"
"Наборы команд не найдены! Это признак критической ошибки. Если\n"
"отключение/переподключение не решает проблему, свяжитесь\n"
"с администратором сервера другим способом.\n"

#: commands/cmdhandler.py:129
msgid ""
"\n"
"A command handler bug occurred. If this is not due to a local change,\n"
"please file a bug report with the Evennia project, including the\n"
"traceback and steps to reproduce.\n"
msgstr ""
"\n"
"Ошибка обработчика команд. Если это не связано с локальными изменениями,\n"
"пожалуйста, создайте отчёт об ошибке для проекта Evennia,\n"
"включая трассировку и шаги для воспроизведения.\n"

#: commands/cmdhandler.py:136
msgid ""
"\n"
"A command handler bug occurred. Please notify staff - they should\n"
"likely file a bug report with the Evennia project.\n"
msgstr ""
"\n"
"Ошибка обработчика команд. Уведомите команду — им следует\n"
"создать отчёт об ошибке для проекта Evennia.\n"

#: commands/cmdhandler.py:144
#, python-brace-format
msgid "Command recursion limit ({recursion_limit}) reached for '{raw_cmdname}' ({cmdclass})."
msgstr "Достигнут предел рекурсии команд ({recursion_limit}) для '{raw_cmdname}' ({cmdclass})."

#: commands/cmdhandler.py:170
#, python-brace-format
msgid ""
"{traceback}\n"
"{errmsg}\n"
"(Traceback was logged {timestamp})."
msgstr ""
"{traceback}\n"
"{errmsg}\n"
"(Трассировка записана в лог {timestamp})."

#: commands/cmdhandler.py:708
msgid "There were multiple matches."
msgstr "Здесь было несколько совпадений."

#: commands/cmdhandler.py:733
#, python-brace-format
msgid "Command '{command}' is not available."
msgstr "Команда '{command}' недоступна."

#: commands/cmdhandler.py:743
#, python-brace-format
msgid " Maybe you meant {command}?"
msgstr " Возможно, вы имели в виду {command}?"

#: commands/cmdhandler.py:745
msgid "or"
msgstr "или"

#: commands/cmdhandler.py:749
msgid " Type \"help\" for help."
msgstr " Введите \"справка\" для получения помощи."

