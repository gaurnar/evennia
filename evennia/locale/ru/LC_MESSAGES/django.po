"{traceback}\n"
"Ошибка загрузки набора команд '{path}'\n"
"(Трассировка записана в лог {timestamp})"

#: commands/cmdsethandler.py:97
#, python-brace-format
msgid ""
"Error loading cmdset: No cmdset class '{classname}' in '{path}'.\n"
"(Traceback was logged {timestamp})"
msgstr ""
"Ошибка загрузки набора команд: класс '{classname}' не найден в '{path}'.\n"
"(Трассировка записана в лог {timestamp})"

#: commands/cmdsethandler.py:102
#, python-brace-format
msgid ""
"{traceback}\n"
"SyntaxError encountered when loading cmdset '{path}'.\n"
"(Traceback was logged {timestamp})"
msgstr ""
"{traceback}\n"
"Синтаксическая ошибка при загрузке набора команд '{path}'.\n"
"(Трассировка записана в лог {timestamp})"

#: commands/cmdsethandler.py:108
#, python-brace-format
msgid ""
"{traceback}\n"
"Compile/Run error when loading cmdset '{path}'.\n"
"(Traceback was logged {timestamp})"
msgstr ""
"{traceback}\n"
"Ошибка компиляции/выполнения при загрузке набора команд '{path}'.\n"
"(Трассировка записана в лог {timestamp})"

#: commands/cmdsethandler.py:114
#, python-brace-format
msgid ""
"\n"
"Error encountered for cmdset at path '{path}'.\n"
"Replacing with fallback '{fallback_path}'.\n"
msgstr ""
"\n"
"Ошибка при загрузке набора команд '{path}'.\n"
"Замена резервным набором '{fallback_path}'.\n"

#: commands/cmdsethandler.py:120
#, python-brace-format
msgid "Fallback path '{fallback_path}' failed to generate a cmdset."
msgstr "Резервный путь '{fallback_path}' не смог создать набор команд."

#: commands/cmdsethandler.py:189 commands/cmdsethandler.py:201
#, python-brace-format
msgid ""
"\n"
"(Unsuccessfully tried '{path}')."
msgstr ""
"\n"
"(Безуспешная попытка загрузить '{path}')."

#: commands/cmdsethandler.py:332
#, python-brace-format
msgid "custom {mergetype} on cmdset '{cmdset}'"
msgstr "нестандартное слияние {mergetype} для набора команд '{cmdset}'"

#: commands/cmdsethandler.py:458
msgid "Only CmdSets can be added to the cmdsethandler!"
msgstr "В обработчик наборов команд можно добавлять только объекты CmdSet!"

