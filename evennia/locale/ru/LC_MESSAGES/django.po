#: prototypes/prototypes.py:431 prototypes/prototypes.py:501 prototypes/prototypes.py:1163
#, python-brace-format
msgid "{protkey} is a read-only prototype (defined as code in {module})."
msgstr "Прототип {protkey} доступен только для чтения (определён в коде модуля {module})."

#: prototypes/prototypes.py:433 prototypes/prototypes.py:503 prototypes/prototypes.py:1165
#, python-brace-format
